# Copy this file to .env and fill in values from your Supabase project:
# Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public site URL (canonical domain for SEO, sitemap, Open Graph)
VITE_SITE_URL=https://elitealhussam.com

# Google Analytics 4 measurement ID (optional — page views on all public routes)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
